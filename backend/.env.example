# --- Required in production (ENVIRONMENT=production) ---
ENVIRONMENT=production
# Random secret, >=32 chars. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# Comma-separated frontend origins, e.g. https://app.example.com
ALLOWED_ORIGINS=
# PostgreSQL DSN, e.g. postgresql+psycopg://user:pass@host:5432/ai_screenx
DATABASE_URL=

# --- Optional ---
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAX_UPLOAD_MB=5
RESUME_RETENTION_DAYS=365

# --- Worker ---
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=900

# --- Private resume storage (S3-compatible; STORAGE_BACKEND=s3) ---
STORAGE_BACKEND=local
STORAGE_DIR=
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Malware scanning (clamd) ---
# CLAMAV_REQUIRED=true fails closed (503) when the scanner is unavailable.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
CLAMAV_TIMEOUT_SECONDS=10

# --- Audit retention (days; <=0 disables purge) ---
AUDIT_RETENTION_DAYS=730

# --- Startup migrations (single-instance hosts only, e.g. Render free) ---
# Applies `alembic upgrade head` at boot. Only enable on ONE instance.
RUN_MIGRATIONS_ON_START=false

# --- Public demo seed (backend/seed_demo.py) ---
# Credentials shown on the public landing page; synthetic data only.
DEMO_RECRUITER_EMAIL=demo@aiscreenx.app
DEMO_RECRUITER_PASSWORD=DemoScreenX2025
