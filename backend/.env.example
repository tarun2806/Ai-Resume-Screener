# --- Required in production (ENVIRONMENT=production) ---
ENVIRONMENT=production
# Random secret, >=32 chars. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# Comma-separated frontend origins, e.g. https://app.example.com
ALLOWED_ORIGINS=
# PostgreSQL DSN, e.g. postgresql+psycopg://user:pass@host:5432/ai_screenx
DATABASE_URL=

# --- Optional ---
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAX_UPLOAD_MB=5
RESUME_RETENTION_DAYS=365
